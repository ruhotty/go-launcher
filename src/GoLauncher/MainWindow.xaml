<Window x:Class="GoLauncher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Go Launcher" Height="720" Width="1100" MinHeight="520" MinWidth="760" Background="#101116" Foreground="#F5F5F7" WindowStartupLocation="CenterScreen"><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><StackPanel><TextBlock Text="GO LAUNCHER" FontSize="25" FontWeight="Bold"/><TextBlock Text="Your games, one click away" Foreground="#9295A1" Margin="0,4,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="Refresh" Click="Refresh_Click" Padding="18,9" Background="#272934" Foreground="White" BorderThickness="0"/></DockPanel><TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,24,0,18" Height="42" Padding="12" FontSize="15" Background="#1B1D25" Foreground="White" BorderBrush="#343743" TextChanged="SearchBox_TextChanged" VerticalContentAlignment="Center"/><ListView x:Name="GamesList" Grid.Row="2" Background="#17191F" BorderThickness="0" Foreground="White" SelectionMode="Single"><ListView.ItemTemplate><DataTemplate><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding AppId, StringFormat=App ID: {0}}" Foreground="#9295A1" FontSize="11" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Content="PLAY" Tag="{Binding AppId}" Click="Play_Click" Padding="22,9" Background="#8B5CF6" Foreground="White" BorderThickness="0" FontWeight="Bold"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid></Window>