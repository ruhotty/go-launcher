<Window x:Class="GoLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Go Launcher" Height="760" Width="1120" MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen" Background="#111318" Foreground="#F4F6FA"
        FontFamily="Segoe UI" Loaded="Window_Loaded">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="GO LAUNCHER" FontSize="13" FontWeight="Bold" Foreground="#75B8FF" />
                <TextBlock Text="Your games. One click away." FontSize="29" FontWeight="SemiBold" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="SteamButton" Content="Open Steam" Click="SteamButton_Click"
                    Padding="18,11" Background="#252A34" Foreground="White" BorderThickness="0"
                    FontWeight="SemiBold" Cursor="Hand"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Height="43" Padding="14,10" FontSize="14"
                     Background="#20232B" Foreground="White" BorderThickness="0"
                     VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"
                     ToolTip="Search your installed games"/>
            <Button Grid.Column="1" Content="Refresh library" Click="RefreshButton_Click"
                    Margin="12,0,0,0" Padding="16,8" Background="#75B8FF" Foreground="#111318"
                    BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
        </Grid>

        <Border Grid.Row="2" Background="#17191F" CornerRadius="12" Padding="16">
            <DockPanel>
                <TextBlock x:Name="LibraryHeading" DockPanel.Dock="Top" Text="YOUR LIBRARY"
                           FontSize="12" FontWeight="Bold" Foreground="#9BA3B4" Margin="2,0,0,14"/>
                <ListView x:Name="GamesList" Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#20232B" CornerRadius="8" Padding="15" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding AppId, StringFormat=APP ID {0}}" FontSize="11"
                                                   Foreground="#9BA3B4" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="PLAY" Tag="{Binding}" Click="PlayButton_Click"
                                            Padding="20,9" Background="#75B8FF" Foreground="#111318"
                                            BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="3" x:Name="StatusText" Text="Starting Go Launcher..."
                   Foreground="#9BA3B4" FontSize="12" Margin="2,14,0,0"/>
    </Grid>
</Window>
